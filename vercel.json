{
  "framework": null,
  "installCommand": "cd mobile && npm ci",
  "buildCommand": "cd mobile && npm run build:web",
  "outputDirectory": "mobile/dist",
  "rewrites": [{ "source": "/((?!_expo/|assets/|favicon.ico).*)", "destination": "/index.html" }],
  "headers": [{"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}]
}
